# Python
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
*.egg-info/

# OS
.DS_Store

# Home Assistant container runtime + SECRETS.
# Only configuration.yaml is source; everything else (ha_credentials.json with the
# refresh token, .storage auth, the HA database, logs) must never be committed.
config/*
!config/configuration.yaml
# The Lovelace dashboard is source too: it defines the operator-facing view used to
# verify the demo against ground truth. Entity ids and labels only -- no credentials.
# Re-listed explicitly because `config/*` stops git descending into the subdirectory.
!config/dashboards/
config/dashboards/*
!config/dashboards/rooms.yaml

# Regenerable run traces (deterministic ones reproduce from the harness)
traces/*
# Except the 16 E2 relay traces the number gate reads (scripts/verify_sep10_numbers.py:
# what the undefended planner read and said); without them a fresh clone cannot check
# two printed figures.
!traces/e2_lp_relay_secure_house_delayed_[0-7].jsonl
!traces/e2_lp_relay_secure_house_delayed_until_read_[0-7].jsonl

# LaTeX build artifacts
*.aux
*.lof
*.lot
*.toc
*.out
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
manuscripts/**/*.log

# Local credentials (e.g. SMARTTHINGS_TOKEN) - never commit
.env
.env.*
*.env

# Unpublished manuscript and paper-content/strategy docs.
# These are kept local-only (see the archive/full-with-manuscript branch) and are
# deliberately NOT published to GitHub.
manuscripts/
PROJECT_DOSSIER.md
AUDIT_EVIDENCE.md
MA5_SIMUHOME_RESULT.md
# The manuscript folder was renamed 12-page-manuscript -> 30-page-manuscript on the
# venue change to ACM TIOT. Neither name was matched by the rule above, so the paper
# was unprotected here by an accident of naming. Both are listed, and a glob catches
# the next rename; the paper is under double-anonymous review and must not appear in
# a repository that carries the author's account name.
*-page-manuscript/
12-page-manuscript/
30-page-manuscript/
# Review and submission-strategy documents: reviewer reports, panel findings and the
# venue-options memo are paper content, not code.
paper-review/
OPTIONS-FOR-ADVISOR.md
# A standalone summary of the paper for an advisor -- it carries the manuscript's title
# and argument, so it is paper content that happens to sit under results/.
results/advisor_summary.*
# Generated artifact guide: it embeds the repository URL, so a stale copy built before
# the URL was derived would republish the owner handle the generator no longer contains.
docs/artifact_guide.html
